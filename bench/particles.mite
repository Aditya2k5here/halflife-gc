# particles -- a fixed simulation state with heavy per-tick temporaries.
#
# Why it is here: this is the textbook generational workload, and it is the case
# where a stock nursery already does well. It is in the suite as a control. If a
# learned pretenuring policy makes this *worse*, that matters more than making a
# favourable workload better -- a policy that only helps where it was tuned is
# not a policy.

# `seed` and `scale` are injected by the harness (see halflife/eval/run.py).
# scale=0 is the profiling variant, scale=1 the held-out evaluation variant:
# same code, different input size and shape, so a model trained on one is
# genuinely being tested on the other.

fun rnd(limit) {
  seed = (seed * 1103515245 + 12345) % 2147483648;
  return seed % limit;
}

fun make_particle(id) {
  return record { id: id, x: rnd(1000), y: rnd(1000), vx: rnd(7) - 3, vy: rnd(7) - 3, energy: 0 };
}

# A short-lived force vector, allocated and discarded every tick per particle.
fun force_on(p, tick) {
  return record { dx: (p.y % 5) - 2, dy: (tick % 5) - 2 };
}

fun step(p, tick) {
  let f = force_on(p, tick);
  p.vx = (p.vx + f.dx) % 9;
  p.vy = (p.vy + f.dy) % 9;
  p.x = (p.x + p.vx + 1000) % 1000;
  p.y = (p.y + p.vy + 1000) % 1000;
  p.energy = p.energy + p.vx * p.vx + p.vy * p.vy;
  return p.energy;
}

let particles = [];
let i = 0;
while (i < 450 + scale * 200) {
  push(particles, make_particle(i));
  i = i + 1;
}

let tick = 0;
let total = 0;
while (tick < 25 + scale * 8) {
  let j = 0;
  while (j < len(particles)) {
    total = total + step(particles[j], tick);
    j = j + 1;
  }
  tick = tick + 1;
}

print("particles energy " + str(total % 1000000007));
print("particles count " + str(len(particles)));
