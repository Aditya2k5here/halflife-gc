# doc_pipeline -- parse-transform-emit, with a small fraction of results retained.
#
# Why it is here: the hardest case for any predictor. The same allocation site
# produces an object that is thrown away 95% of the time and kept 5% of the
# time, and which one it is depends on a data-dependent branch taken *after* the
# allocation. No amount of context can make that decision perfectly, so this is
# where the gap between the learned predictor and the perfect oracle should be
# widest -- and where a predictor that is wrong in the expensive direction
# (pretenuring garbage) gets punished.

# `seed` and `scale` are injected by the harness (see halflife/eval/run.py).
# scale=0 is the profiling variant, scale=1 the held-out evaluation variant:
# same code, different input size and shape, so a model trained on one is
# genuinely being tested on the other.

fun rnd(limit) {
  seed = (seed * 1103515245 + 12345) % 2147483648;
  return seed % limit;
}

fun make_field(i) {
  return record { name: "f" + str(i), value: rnd(100000), tag: i % 7 };
}

fun make_doc(id, nfields) {
  let fields = [];
  let i = 0;
  while (i < nfields) {
    push(fields, make_field(i));
    i = i + 1;
  }
  return record { id: id, fields: fields, score: 0 };
}

fun score_doc(d) {
  let s = 0;
  let i = 0;
  while (i < len(d.fields)) {
    let f = d.fields[i];
    s = s + f.value % (f.tag + 2);
    i = i + 1;
  }
  d.score = s;
  return s;
}

# The index is immortal; the documents in it are a biased sample of all documents.
let index = [];
let processed = 0;
let checksum = 0;
let n = 0;

while (n < 900 + scale * 400) {
  let doc = make_doc(n, 5 + rnd(8 + scale * 4));
  checksum = (checksum + score_doc(doc)) % 1000000007;
  processed = processed + 1;
  if (doc.score % 6 == 0) {
    push(index, doc);
  }
  n = n + 1;
}

print("doc processed " + str(processed));
print("doc indexed " + str(len(index)));
print("doc checksum " + str(checksum));
